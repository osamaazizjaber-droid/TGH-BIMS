# BIMS Environment Configuration Template

# Server Listening Port
PORT=5000

# JSON Web Token Secret (replace with a long random key)
JWT_SECRET=your-jwt-auth-secret-key-change-this

# Master Database Google Sheet ID (from the Spreadsheet URL)
MASTER_SPREADSHEET_ID=1_YOUR_MASTER_SPREADSHEET_ID_HERE_xxxxxxxxxxxxxxxxx

# Google Cloud Service Account JSON Key (single-line string representation)
# Example: GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email": "..."}
# Alternatively, you can save the downloaded credentials JSON file as 'credentials.json' directly in the backend/ directory.
GOOGLE_SERVICE_ACCOUNT_JSON=
